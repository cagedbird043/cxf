#compdef cxf

# ── helpers ────────────────────────────────────────────────────────────

_cxf_provider_ids() {
  local provider_dir="${HOME}/.codex/cxf/providers"
  [[ -d "$provider_dir" ]] || return
  local -a providers
  providers=("${provider_dir}"/*.toml(N:t:r))
  _describe -t providers 'provider' providers
}

_cxf_claude_provider_ids() {
  local provider_dir="${HOME}/.codex/cxf/claude/providers"
  [[ -d "$provider_dir" ]] || return
  local -a providers
  providers=("${provider_dir}"/*.toml(N:t:r))
  _describe -t providers 'claude provider' providers
}

# ── messages ───────────────────────────────────────────────────────────

# (reuse the same conditional as in the main function)

_cxf_cmd_descriptions() {
  local -a _cmds
    if [[ $LANG = zh_* ]]; then
    _cmds=(
      'init:从当前配置初始化托管 provider'
      'list:列出所有托管 provider'
      'current:显示当前激活的 provider'
      'use:切换到指定 provider'
      'add:添加 provider'
      'edit:编辑 provider'
      'remove:删除 provider'
      'rename:重命名 provider'
      'status:检查 cxf 是否管控当前 provider'
      'claude:管理 Claude Code provider 指针'
    )
  else
    _cmds=(
      'init:initialize managed providers from current config'
      'list:list managed providers'
      'current:show active provider'
      'use:switch to a managed provider'
      'add:add a provider'
      'edit:open a provider in $EDITOR'
      'remove:remove a managed provider'
      'rename:rename a provider'
      'status:check whether cxf controls the active provider'
      'claude:manage Claude Code provider pointer'
    )
  fi
  _describe -t commands 'cxf command' _cmds
}

_cxf_claude_descriptions() {
  local -a _cmds
  if [[ $LANG = zh_* ]]; then
    _cmds=(
      'init:从当前设置初始化 Claude provider'
      'list:列出所有托管 Claude provider'
      'current:显示当前激活的 Claude provider'
      'add:添加 Claude provider'
      'edit:编辑 Claude provider'
      'use:切换 Claude Code 到指定 provider'
      'remove:删除 Claude provider'
      'rename:重命名 Claude provider'
      'status:检查 cxf 是否管控 Claude 设置'
    )
  else
    _cmds=(
      'init:initialize Claude providers from current settings'
      'list:list managed Claude providers'
      'current:show active Claude provider'
      'add:add a Claude provider'
      'edit:open a Claude provider in $EDITOR'
      'use:switch Claude Code to a managed provider'
      'remove:remove a managed Claude provider'
      'rename:rename a Claude provider'
      'status:check whether cxf controls Claude settings'
    )
  fi
  _describe -t claude-commands 'claude command' _cmds
}

# ── main ───────────────────────────────────────────────────────────────

_cxf() {
  if (( CURRENT == 2 )); then
    # top-level command
    _cxf_cmd_descriptions
    return
  fi

  # CURRENT >= 3 — completing args for the selected command
  case "$words[2]" in
    init)
      (( CURRENT > 3 )) && return
      _message 'provider id'
      ;;
    use|edit|remove|rename)
      (( CURRENT > 3 )) && return
      _cxf_provider_ids
      ;;
    add)
      if (( CURRENT == 3 )); then
        if [[ $LANG = zh_* ]]; then
          _arguments \
            '--provider-id[Provider 名称，省略则交互式输入]' \
            '--model-providers[模型提供商名称]' \
            '--base-url[API 地址]' \
            '--api-key[API 密钥]' \
            '--wire-api[API 格式]:wire:(responses chat)' \
            '--no-websocket[禁用 WebSocket]'
        else
          _arguments \
            '--provider-id[provider id (interactive if omitted)]' \
            '--model-providers[model provider name]' \
            '--base-url[API base URL]' \
            '--api-key[API key]' \
            '--wire-api[API wire format]:wire:(responses chat)' \
            '--no-websocket[disable WebSocket]'
        fi
      fi
      ;;
    claude)
      if (( CURRENT == 3 )); then
        _cxf_claude_descriptions
      elif (( CURRENT == 4 )) && [[ "$words[3]" == (use|edit|remove|rename) ]]; then
        _cxf_claude_provider_ids
      elif (( CURRENT == 4 )) && [[ "$words[3]" == init ]]; then
        _message 'provider id'
      elif (( CURRENT == 4 )) && [[ "$words[3]" == add ]]; then
        if [[ $LANG = zh_* ]]; then
          _arguments \
            '--provider-id[Provider 名称，省略则交互式输入]' \
            '--base-url[Anthropic 兼容 API 地址]' \
            '--api-key[Anthropic API 密钥]' \
            '--model[模型名称]'
        else
          _arguments \
            '--provider-id[provider id (interactive if omitted)]' \
            '--base-url[Anthropic-compatible base URL]' \
            '--api-key[Anthropic API key]' \
            '--model[model name]'
        fi
      fi
      ;;
    list|current|status)
      # no further args
      return 1
      ;;
  esac
}

_cxf "$@"
