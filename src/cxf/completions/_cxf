#compdef cxf

_cxf_provider_ids() {
  local provider_dir="${HOME}/.codex/cxf/providers"
  [[ -d "$provider_dir" ]] || return
  local -a providers
  providers=("${provider_dir}"/*.toml(N:t:r))
  _describe -t providers 'provider' providers
}

_cxf_snapshots() {
  local snapshot_dir="${HOME}/.codex/cxf/snapshots"
  [[ -d "$snapshot_dir" ]] || return
  local -a snapshots
  snapshots=("${snapshot_dir}"/*(N:t))
  _describe -t snapshots 'snapshot' snapshots
}

_cxf_claude_provider_ids() {
  local provider_dir="${HOME}/.codex/cxf/claude/providers"
  [[ -d "$provider_dir" ]] || return
  local -a providers
  providers=("${provider_dir}"/*.toml(N:t:r))
  _describe -t providers 'claude provider' providers
}

_cxf() {
  local context state line
  typeset -A opt_args
  local -a commands

  commands=(
    'init:initialize ~/.codex/cxf from existing Codex providers'
    'add:interactively add a provider'
    'list:list managed providers'
    'current:show current provider pointer'
    'edit:open provider file in $EDITOR'
    'use:switch Codex provider pointer'
    'doctor:check whether provider pointer is controlled'
    'snapshot:snapshot Codex and cxf config files'
    'restore:restore a snapshot'
    'completion:print shell completion'
    'claude:manage Claude Code provider pointer'
  )

  _arguments -C \
    '1:command:->command' \
    '*::arg:->arg'

  case "$state" in
    command)
      _describe -t commands 'cxf command' commands
      ;;
    arg)
      case "$line[1]" in
        init)
          (( CURRENT > 3 )) && return 1
          _message 'provider id'
          ;;
        use|edit)
          (( CURRENT > 3 )) && return 1
          [[ -n "$words[3]" && -f "${HOME}/.codex/cxf/providers/${words[3]}.toml" ]] && return 1
          _cxf_provider_ids
          ;;
        restore)
          (( CURRENT > 3 )) && return 1
          [[ -n "$words[3]" && -d "${HOME}/.codex/cxf/snapshots/${words[3]}" ]] && return 1
          _cxf_snapshots
          ;;
        completion)
          (( CURRENT > 3 )) && return 1
          [[ "$words[3]" == "zsh" ]] && return 1
          _values 'shell' zsh
          ;;
        claude)
          local -a claude_commands
          claude_commands=(
            'init:initialize Claude provider profiles'
            'list:list Claude providers'
            'current:show current Claude provider pointer'
            'edit:open Claude provider file in $EDITOR'
            'use:switch Claude provider pointer'
            'doctor:check whether Claude provider pointer is controlled'
          )
          if (( CURRENT == 3 )); then
            _describe -t claude-commands 'claude command' claude_commands
          elif [[ "$words[3]" == (use|edit) ]]; then
            [[ -n "$words[4]" && -f "${HOME}/.codex/cxf/claude/providers/${words[4]}.toml" ]] && return 1
            _cxf_claude_provider_ids
          elif [[ "$words[3]" == init ]]; then
            _message 'provider id'
          else
            return 1
          fi
          ;;
        add|list|current|doctor|snapshot)
          return 1
          ;;
      esac
      ;;
  esac
}

_cxf "$@"
